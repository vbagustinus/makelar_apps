{
  "name": "Makelar",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "source ~/.bash_profile && react-native run-android",
    "ios:dev": "yarn env:dev && react-native run-ios --configuration=DebugDev --scheme=AbsensiDparagon --simulator='iPhone 16'",
    "ios:dev:d": "yarn setDevelopment && react-native run-ios --configuration=DebugDev --scheme=AbsensiDparagon --device='iPhone 11 Pro (18.2.1)'",
    "ios:dev-release": "yarn setDevelopment && react-native run-ios --configuration=ReleaseDev --scheme=AbsensiDparagon",
    "ios:prod": "yarn env:prod && react-native run-ios --configuration=Debug --scheme=AbsensiDparagon --simulator='iPhone 16 Pro'",
    "ios:prod-release": "yarn setProduction && react-native run-ios --configuration=Release --scheme=AbsensiDparagon",
    "prebuild:ios:production": "bash scripts/env-to-xcconfig.sh .env.production ios/Config/DebugProduction.xcconfig && bash scripts/env-to-xcconfig.sh .env.production ios/Config/ReleaseProduction.xcconfig",
    "prebuild:ios:development": "bash scripts/env-to-xcconfig.sh .env.development ios/Config/DebugDevelopment.xcconfig && bash scripts/env-to-xcconfig.sh .env.development ios/Config/ReleaseDevelopment.xcconfig",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint .",
    "setDevelopment": "ENVFILE=.env.development",
    "setProduction": "ENVFILE=.env.production",
    "env:dev": "cp .env.development .env",
    "env:prod": "cp .env.production .env",
    "env:reset": "cp .env.default .env",
    "android:remove:assets": "rm -rf ./android/app/src/main/res/drawable-*",
    "build:apk:development": "yarn env:dev && cd android && ./gradlew clean && echo '\n\nCleaning gradle complete / 100%\n' && ./gradlew assembleDevelopmentRelease && killall -9 java && cd ..",
    "build:apk:production": "yarn env:prod && cd android && ./gradlew clean && echo '\n\nCleaning gradle complete / 100%\n' && ./gradlew assembleProductionRelease && killall -9 java && cd ..",
    "build:apk:aab": "yarn env:prod && cd android && ./gradlew clean && echo '\n\nCleaning gradle complete / 100%\n' && cd .. && react-native build-android --mode=release && killall -9 java",
    "bundle:reset:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res/",
    "bundle:reset:ios": "react-native bundle --platform ios --dev false --entry-file index.js --bundle-output ios/main.jsbundle --assets-dest ios",
    "bundle": "yarn install && yarn bundle:reset:android && yarn bundle:reset:ios",
    "android:dev:clean": "cd android && ./gradlew :app:uninstallAll && react-native run-android --mode=developmentdebug --appId=com.makelar_apps",
    "android:dev": "yarn env:dev && react-native run-android --mode=developmentdebug --appId=com.makelar_apps.dev",
    "android:prod": "yarn env:prod && react-native run-android --mode=productiondebug --appId=com.makelar_apps",
    "android:prod:r": "yarn env:prod && react-native run-android --mode=productionrelease --appId=com.makelar_apps",
    "android:clean": "cd android && ./gradlew clean && ./gradlew :app:uninstallAll && cd ..",
    "start:reset": "react-native start --reset-cache",
    "start:development": "./prepare-env.sh development && npm run start:reset",
    "start:production": "./prepare-env.sh production && npm run start:reset",
    "codepush:android:production": "revopush release-react MyRDL-iOS android -d prod-android",
    "clean": "watchman watch-del-all && rm -rf node_modules/ && touch yarn.lock && yarn cache clean && yarn install",
    "pretty": "prettier --write '**/*.{js,ts,tsx}'",
    "error:ninja": "rm -rf android/.cxx android/app/.cxx android/app/build node_modules"
  },
  "dependencies": {
    "@d11/react-native-fast-image": "^8.12.0",
    "@dr.pogodin/react-native-fs": "^2.36.0",
    "@gorhom/bottom-sheet": "^5.2.6",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-camera-roll/camera-roll": "^7.10.2",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-firebase/analytics": "^23.4.1",
    "@react-native-firebase/app": "^23.4.1",
    "@react-native-firebase/auth": "^23.4.1",
    "@react-native-firebase/firestore": "^23.4.1",
    "@react-native-firebase/remote-config": "^23.4.1",
    "@react-native-firebase/storage": "^23.4.1",
    "@react-native-google-signin/google-signin": "^16.0.0",
    "@react-native-ohos/react-native-image-resizer": "^3.0.12-rc.1",
    "@react-native-vector-icons/common": "^12.3.0",
    "@react-native-vector-icons/ionicons": "^12.3.0",
    "@react-native-vector-icons/material-design-icons": "^12.4.0",
    "@react-native/new-app-screen": "^0.82.1",
    "@react-navigation/bottom-tabs": "^7.4.9",
    "@react-navigation/native": "^7.1.18",
    "@react-navigation/native-stack": "^7.3.28",
    "@shopify/flash-list": "^2.1.0",
    "@shopify/react-native-skia": "^2.4.14",
    "aes-js": "^3.1.2",
    "dayjs": "^1.11.18",
    "libphonenumber-js": "^1.12.24",
    "lottie-ios": "^4.5.1",
    "lottie-react-native": "^7.3.4",
    "react": "19.1.1",
    "react-native": "0.82.1",
    "react-native-animatable": "^1.4.0",
    "react-native-app-auth": "^8.1.0",
    "react-native-bootsplash": "^6.3.11",
    "react-native-country-select": "^0.3.2",
    "react-native-device-info": "^14.1.1",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-google-mobile-ads": "^15.8.3",
    "react-native-image-picker": "^8.2.1",
    "react-native-image-resizer": "^1.4.5",
    "react-native-image-zoom-viewer": "^3.0.1",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-maps": "^1.26.20",
    "react-native-mmkv": "^4.0.0",
    "react-native-modal": "^14.0.0-rc.1",
    "react-native-nitro-modules": "^0.31.4",
    "react-native-otp-entry": "^1.8.5",
    "react-native-print": "^0.11.0",
    "react-native-qrcode-svg": "^6.3.15",
    "react-native-reanimated": "^4.1.3",
    "react-native-reanimated-carousel": "^4.0.3",
    "react-native-reanimated-skeleton": "^1.6.0",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-screens": "^4.17.1",
    "react-native-share": "^12.2.0",
    "react-native-svg": "^15.15.1",
    "react-native-svg-transformer": "^1.5.2",
    "react-native-ui-datepicker": "^3.1.2",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-view-shot": "^4.0.3",
    "react-native-worklets": "^0.7.1",
    "rn-placeholder": "^3.0.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.82.1",
    "@react-native/eslint-config": "0.82.1",
    "@react-native/metro-config": "0.82.1",
    "@react-native/typescript-config": "0.82.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.1.1",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.1.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
